# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Names match TASK.md [C9]; every lane uses these exact keys.

# The camera grid. HLS is served by the CDN host behind a sign-in; RTSP and WHEP are served
# directly on the public IP because a CDN cannot proxy them.
GRID_CDN=https://cctv.corp8.cloud   # HLS + catalogue, behind the sign-in below
GRID_IP=103.250.160.189             # RTSP :8554, WHEP :8889

# The sign-in takes BOTH fields. The key on its own returns "Email or access password is
# incorrect", which is indistinguishable from an expired key and has cost an hour before.
GRID_EMAIL=
GRID_KEY=
POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=sentinel_dev_only
API_BASE=http://localhost:8000
WEB_PORT=5173
OSRM_URL=http://localhost:5000
# Must be at least 32 bytes. Left unset, the API invents a random key per process and every
# token stops working the moment anything restarts.
JWT_SECRET=dev_only_change_me_to_at_least_32_bytes

# The console holds these server-side so the operator never meets a login form. Two accounts,
# because [C10] gives admin:audit to SYSTEM_ADMIN and denies that role live data - one account
# cannot serve both the map and the audit tab.
PRAHARI_CONSOLE_USER=field
PRAHARI_CONSOLE_PASSWORD=
PRAHARI_CONSOLE_ADMIN_USER=console-audit
PRAHARI_CONSOLE_ADMIN_PASSWORD=
FRAME_FPS=5
FRAME_WIDTH=960

# Host ports the compose stack publishes on. Override when something already holds the
# default - a local Postgres on 5432 answers before Docker's proxy and auth then fails
# with the compose credentials, which looks like a password bug and is not one.
POSTGRES_PORT=5432
REDIS_PORT=6379
OSRM_PORT=5000
