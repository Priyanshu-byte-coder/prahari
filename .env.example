# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# ---- Sentinel sandbox grid -------------------------------------------------
# The host you get after logging in at sentinel.gujarat.gov.in -> Resources.
# Local development uses our own MediaMTX clone of the grid on localhost.
SENTINEL_HOST=localhost
SENTINEL_BASE_URL=http://localhost:8080
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_PORT=8889
SENTINEL_HLS_PORT=8888

# Only if the portal issues them. Leave blank when the grid is open post-login.
SENTINEL_USER=
SENTINEL_PASSWORD=
SENTINEL_TOKEN=
SENTINEL_COOKIE=

# ---- Local infrastructure --------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_only
REDIS_URL=redis://localhost:6379/0

# ---- Worker ----------------------------------------------------------------
# The CV stack (torch, ultralytics, easyocr) is several GB and is installed in
# its own environment outside this repository. Point this at that interpreter.
# Local choice -- keep the real path here in .env, never in committed docs.
#   Windows:  E:\somewhereenv\Scripts\python.exe
#   macOS:    /Users/you/envs/prahari/bin/python
PRAHARI_CV_PYTHON=python

# Where the worker writes detections, and where the route engine reads them.
# Overridden in testing so synthetic fixtures never mix with real captures.
PRAHARI_DETECTIONS_DIR=data/detections
# Frames per second sampled for inference. The grid delivers more; we do not
# need every frame for ANPR and 5fps is a 5x compute saving.
INFERENCE_FPS=5
MAX_CONCURRENT_CAMERAS=8
DEVICE=cuda
