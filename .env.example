# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Names match TASK.md [C9]; every lane uses these exact keys.

GRID_HOST=live.corp8.cloud      # RTSP :8554  WHEP :8889  HLS :80  catalogue GET /api/ingest
POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=sentinel_dev_only
API_BASE=http://localhost:8000
WEB_PORT=5173
OSRM_URL=http://localhost:5000
JWT_SECRET=dev_only_change_me
FRAME_FPS=5
FRAME_WIDTH=960

# Host ports the compose stack publishes on. Override when something already holds the
# default - a local Postgres on 5432 answers before Docker's proxy and auth then fails
# with the compose credentials, which looks like a password bug and is not one.
POSTGRES_PORT=5432
REDIS_PORT=6379
OSRM_PORT=5000
